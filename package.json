{
  "name": "retext-pdf",
  "productName": "Retext PDF",
  "version": "4.0.0",
  "description": "Local PDF and Markdown editor with true text editing and redaction",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "serve": "node app/server.js",
    "test": "node app/pdf-engine.test.js && node app/text-grouping.test.js && node app/ui-wiring.test.js && node app/server.test.js && node app/pdf-fonts.test.js && node app/pdf-system-fonts.test.js && node app/pdf-edit-service.test.js",
    "dist": "electron-builder --win",
    "md2pdf": "electron tools/md2pdf.js",
    "assets": "node tools/demo-assets.js",
    "icon": "electron tools/make-icon.js",
    "dist:store": "node tools/dist-store.js",
    "appx-assets": "electron tools/make-appx-assets.js",
    "hero": "electron tools/make-hero.js"
  },
  "build": {
    "appId": "com.kindsusu.retextpdf",
    "productName": "Retext PDF",
    "artifactName": "Retext-PDF-${version}-${arch}-${os}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**",
      "package.json",
      "workspace/sample.pdf",
      "workspace/회의록_초안.md",
      "workspace/회의록_초안.pdf",
      "LICENSE"
    ],
    "asar": true,
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "description": "PDF 문서",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "Retext-PDF-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "Retext-PDF-${version}-setup.exe",
      "shortcutName": "Retext PDF"
    },
    "appx": {
      "applicationId": "RetextPDF",
      "identityName": "susukim.EDITORKIM",
      "publisher": "CN=9E51FDEE-767C-4BB7-A86D-154F244519D6",
      "displayName": "Retext PDF",
      "publisherDisplayName": "susukim",
      "backgroundColor": "#1b1b1f",
      "languages": [
        "ko-KR",
        "en-US"
      ],
      "artifactName": "Retext-PDF-${version}-store.${ext}",
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.26100.0"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kindsusu/EDITOR_KIM.git"
  },
  "homepage": "https://github.com/kindsusu/EDITOR_KIM",
  "bugs": "https://github.com/kindsusu/EDITOR_KIM/issues",
  "author": "kindsusu",
  "keywords": [
    "pdf",
    "pdf-editor",
    "redaction",
    "pdfium",
    "electron",
    "markdown"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@embedpdf/pdfium": "^2.15.0",
    "dompurify": "^3.4.13",
    "fontkit": "^2.0.4",
    "jpeg-js": "^0.4.4",
    "marked": "^15.0.7"
  }
}
