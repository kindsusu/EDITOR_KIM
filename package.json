{
  "name": "editor-kim",
  "productName": "EDITOR_KIM",
  "version": "0.5.0",
  "description": "Local PDF & Markdown editor with true text editing and redaction — Claude Code or ChatGPT/Codex, no API key",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "serve": "node app/server.js",
    "test": "node app/pdf-engine.test.js && node app/ai-providers.test.js",
    "dist": "electron-builder --win",
    "md2pdf": "electron tools/md2pdf.js",
    "assets": "node tools/demo-assets.js",
    "icon": "electron tools/make-icon.js"
  },
  "build": {
    "appId": "com.kindsusu.editorkim",
    "productName": "EDITOR_KIM",
    "artifactName": "EDITOR_KIM-${version}-${arch}-${os}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**",
      "package.json",
      "workspace/sample.pdf",
      "workspace/회의록_초안.md",
      "workspace/회의록_초안.pdf",
      "LICENSE"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "EDITOR_KIM-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "EDITOR_KIM-${version}-setup.exe",
      "shortcutName": "EDITOR_KIM"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kindsusu/EDITOR_KIM.git"
  },
  "homepage": "https://github.com/kindsusu/EDITOR_KIM",
  "bugs": "https://github.com/kindsusu/EDITOR_KIM/issues",
  "author": "kindsusu",
  "keywords": [
    "pdf",
    "pdf-editor",
    "redaction",
    "pdfium",
    "electron",
    "markdown",
    "claude-code",
    "codex",
    "chatgpt"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@embedpdf/pdfium": "^2.15.0",
    "dompurify": "^3.4.13",
    "fontkit": "^2.0.4",
    "marked": "^15.0.7"
  }
}
